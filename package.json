{
  "name": "comfyui-node-organizer",
  "version": "2.0.0",
  "description": "ComfyUI extension to organize nodes",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./core": {
      "import": "./lib/core.js",
      "types": "./lib/core.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "watch": "tsc && vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup:e2e": "tsx scripts/setup-test-comfy.ts",
    "test:e2e": "playwright test",
    "ci:local": "act push --workflows .github/workflows/ci.yaml -j unit-tests"
  },
  "keywords": [
    "comfyui",
    "custom node",
    "custom",
    "node",
    "extension",
    "organizer",
    "node",
    "extension"
  ],
  "author": "PBandDev",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "^1.32.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "fast-check": "^4.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
